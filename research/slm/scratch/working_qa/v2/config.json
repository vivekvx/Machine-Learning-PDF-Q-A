{
  "schema_version": 2,
  "reason": "Candidate-specific bidirectional evidence scoring replaces the v1 pooled multi-candidate NULL softmax that collapsed to abstention",
  "dataset_manifest": "../v1/manifest.json",
  "seed": 20261014,
  "model": {"layers": 4, "embedding_dim": 128, "attention_heads": 4,
            "context_length": 256, "feed_forward_multiplier": 4,
            "normalization_epsilon": 0.00001},
  "training": {"optimizer": "AdamW", "learning_rate": 0.001,
               "weight_decay": 0.01, "batch_size": 1, "gradient_clip_l2": 1.0,
               "tiny_examples": 8, "tiny_steps_cap": 120, "tiny_eval_interval": 10,
               "main_steps_cap": 1450, "main_eval_interval": 145,
               "fixed_train_examples": 80, "fixed_validation_examples": 160,
               "minimum_steps_before_early_stop": 580,
               "early_stop_patience_evaluations": 4,
               "tiny_wall_seconds": 90, "main_wall_seconds": 180,
               "combined_v1_v2_step_cap": 3400,
               "combined_v1_v2_wall_seconds": 420},
  "selection": "maximum balanced fixed-validation accuracy, then lower NLL, then earlier checkpoint",
  "prediction_threshold_logit": 0.0,
  "validation_gate": {"minimum_examples": 320, "answerable_exact_match": 0.70,
                      "unanswerable_accuracy": 0.70,
                      "minimum_harder_subset_exact_match": 0.10,
                      "required_span_support_rate": 1.0},
  "test_policy": "open once only after final model, inference protocol, and full-validation gate are frozen"
}
