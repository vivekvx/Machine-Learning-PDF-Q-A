{
  "schema_version": 1,
  "experiment": "scratch_answerable_only_pointer_reader",
  "seed": 20261014,
  "sources": "original deterministic non-medical technical templates",
  "families_by_split": {
    "train": ["manual", "deployment", "logbook", "specification"],
    "validation": ["bulletin"],
    "test": ["inspection"]
  },
  "documents_per_family": {"train": 75, "validation": 60, "test": 60},
  "questions_per_document": 4,
  "tokenizer_target_size": 960,
  "model": {"layers": 4, "embedding_dim": 128, "attention_heads": 4,
            "context_length": 256, "feed_forward_multiplier": 4,
            "normalization_epsilon": 0.00001},
  "training": {"optimizer": "AdamW", "learning_rate": 0.001,
               "weight_decay": 0.01, "batch_size": 1, "gradient_clip_l2": 1.0,
               "maximum_pair_tokens": 128, "maximum_answer_tokens": 8,
               "tiny_questions": 8, "tiny_steps_cap": 300, "tiny_eval_every": 10,
               "main_steps_cap": 2500, "main_eval_every": 250,
               "fixed_train_questions": 80, "fixed_validation_questions": 120,
               "minimum_steps_before_early_stop": 1000,
               "early_stop_patience_evaluations": 4,
               "tiny_wall_seconds": 90, "main_wall_seconds": 180,
               "maximum_pointer_attempts": 2,
               "total_pointer_steps_cap": 4500,
               "total_pointer_wall_seconds": 360},
  "checkpoint_selection": "maximum fixed-validation exact span accuracy, then lower NLL, then earlier step",
  "validation_gate": {"minimum_examples": 240,
                      "answerable_exact_match": 0.70,
                      "paraphrase_distractor_exact_match": 0.60,
                      "span_copy_support": 1.0,
                      "question_sensitivity_changed_document_fraction": 0.70},
  "test_policy": "sealed until pointer and separate answerability gates both pass",
  "resource_guards": "reuse unchanged scratch/run.py preflight and live guard_reasons"
}
